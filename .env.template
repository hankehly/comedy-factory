# Google Cloud / Vertex AI — model calls authenticate via Application Default
# Credentials (run `gcloud auth application-default login`); these vars pick
# the billing project and region. gemini-3.5 models are only served in the
# global location.
export GOOGLE_CLOUD_PROJECT=
export GOOGLE_CLOUD_LOCATION=global

# Cloudflare Workers AI — used for image generation.
export CLOUDFLARE_ACCOUNT_ID=
export CLOUDFLARE_API_TOKEN=
